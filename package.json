{
  "name": "edx-decals",
  "version": "1.0.0",
  "private": true,
  "description": "EDX Decals sticker shop - Next.js + Supabase + PayMongo (migrated from the PHP/SQLite app)",
   "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
