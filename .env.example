# Copy to .env.local for local development. Set the same keys in Vercel > Project > Settings > Environment Variables.
# Never commit .env.local.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PayMongo (Developers > API keys). Use TEST keys until every check in README passes.
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx
# Comma-separated payment method types enabled on your PayMongo account
PAYMONGO_METHODS=gcash,paymaya,card,qrph

# Public site URL (used for PayMongo success/cancel links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
